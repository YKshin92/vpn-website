# Credentials belong only to the backend environment; never copy into dist.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=ieum_vpn_dev
PGUSER=ieum_app
PGPASSWORD=
PORT=3000
# Windows local credentials are loaded by tools/backend.ps1.

# Explicit AWS read-only opt-in; .env.example is documentation, not auto-loaded.
# Configure an AWS shared profile outside this repository. Never put access keys here.
IEUM_AWS_READ_ONLY=false
IEUM_AWS_PROFILE=ieum-readonly
IEUM_AWS_ACCOUNT_ID=
# Optional resolver IPs, comma-separated. Read-only launcher detects active Windows IPv4 DNS.
IEUM_DNS_SERVERS=
# Optional server-side list, up to 10 Seoul servers; omitted = vpnServer001 / ieumvpn.link.
# For multiple targets, specify each servicePort; omitted ports remain unconfigured for health checks.
# IEUM_AWS_SERVER_TARGETS=[{"instance":"vpnServer001","domain":"ieumvpn.link","servicePort":54137}]
# Keep false until a separate explicit approval for actual AWS changes.
IEUM_LIVE_ROTATION_ENABLED=false
IEUM_OUTLINE_SERVICE_PORT=54137

# Outline key control: keep disabled until DB application and real key test are approved.
IEUM_OUTLINE_WRITES_ENABLED=false

# Closing an uncertain key operation changes only the local journal; keep disabled pending approval.
IEUM_OUTLINE_REVIEWS_ENABLED=false
